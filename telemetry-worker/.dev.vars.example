# Local development values for `npx --yes wrangler@4 dev --local` (copy to .dev.vars, which git ignores).
# Accounts: cookies, the CSRF Origin check, WebAuthn and OAuth redirects use this origin and RP ID.
AUTH_ORIGIN=http://localhost:8787
AUTH_RP_ID=localhost
# Dashboard links shown by /start point here instead of genclass.dev.
DASHBOARD_ORIGIN=http://localhost:8787
# Optional: test Google or GitHub sign-in with your own development OAuth clients (redirect URIs
# http://localhost:8787/auth/google/callback and http://localhost:8787/auth/github/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
