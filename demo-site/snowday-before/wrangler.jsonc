// The live Worker behind snowday-predictor.ca (Dizon account): same name, compatibility date and ASSETS binding.
// Deploy with npm run deploy (package.json: wrangler with the Dizon login, XDG_CONFIG_HOME=~/.config-dizon).
{
  "name": "snowday-predictor",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "assets": { "directory": ".", "binding": "ASSETS" }
}
