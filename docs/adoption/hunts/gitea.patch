+import {env} from 'node:process';
+import {test, expect} from '@playwright/test';
+import {login, apiCreateRepo, apiCreateIssue, randomString} from './utils.ts';
+import type {Page} from '@playwright/test';
+
+// delays the first response to `url` until the returned function is called
+async function holdFirstResponse(page: Page, url: string) {
+  let release!: () => void;
+  const released = new Promise<void>((resolve) => release = resolve);
+  let held = false;
+  await page.route(url, async (route) => {
+    if (held) return route.continue();
+    held = true;
+    const response = await route.fetch();
+    await released;
+    await route.fulfill({response});
+  });
+  return async () => {
+    const finished = page.waitForEvent('requestfinished', (req) => req.url().endsWith(url) && req.postData()!.includes('outdated'));
+    release();
+    await finished;
+    await page.evaluate(() => new Promise(requestAnimationFrame)); // let the page handle the late response
+  };
+}
+
+test('comment preview ignores outdated responses', async ({page, request}) => {
+  const repoName = `e2e-preview-${randomString(8)}`;
+  const owner = env.GITEA_TEST_E2E_USER;
+  await apiCreateRepo(request, {name: repoName, autoInit: false});
+  await Promise.all([apiCreateIssue(request, {owner, repo: repoName, title: 'Preview test'}), login(page)]);
+  await page.goto(`/${owner}/${repoName}/issues/1`);
+
+  const releaseFirst = await holdFirstResponse(page, `/${owner}/${repoName}/markup`);
+  const form = page.locator('#comment-form');
+  const textarea = form.getByPlaceholder('Leave a comment');
+  await textarea.fill('outdated text');
+  await form.getByText('Preview', {exact: true}).click();
+  await form.getByText('Write', {exact: true}).click();
+  await textarea.fill('current text');
+  await form.getByText('Preview', {exact: true}).click();
+  const preview = form.locator('.render-preview');
+  await expect(preview).toHaveText('current text');
+  await releaseFirst();
+  await expect(preview).toHaveText('current text');
+});
+
+test('file editor preview and diff ignore outdated responses', async ({page, request}) => {
+  const repoName = `e2e-preview-${randomString(8)}`;
+  const owner = env.GITEA_TEST_E2E_USER;
+  await Promise.all([apiCreateRepo(request, {name: repoName}), login(page)]);
+  await page.goto(`/${owner}/${repoName}/_edit/main/README.md`);
+  const editor = page.locator('.cm-content[role="textbox"]');
+  const menu = page.locator('.repo-editor-menu');
+
+  for (const {tab, url, panel} of [
+    {tab: 'Preview', url: `/${owner}/${repoName}/markup`, panel: page.locator('.tab[data-tab="preview"] .render-preview')},
+    {tab: 'Preview Changes', url: `/${owner}/${repoName}/_preview/main/README.md`, panel: page.locator('.tab[data-tab="diff"]')},
+  ]) {
+    const releaseFirst = await holdFirstResponse(page, url);
+    await menu.getByText('Edit File', {exact: true}).click();
+    await editor.fill('outdated text');
+    await menu.getByText(tab, {exact: true}).click();
+    await menu.getByText('Edit File', {exact: true}).click();
+    await editor.fill('current text');
+    await menu.getByText(tab, {exact: true}).click();
+    await expect(panel).toContainText('current text');
+    await releaseFirst();
+    await expect(panel).toContainText('current text');
+    await expect(panel).not.toContainText('outdated text');
+    await page.unroute(url);
+  }
+});
