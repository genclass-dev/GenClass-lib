+import type { Page } from '@playwright/test'
+
+import { expect, test } from '@playwright/test'
+import * as path from 'path'
+import { fileURLToPath } from 'url'
+
+import { ensureCompilationIsDone, initPageConsoleErrorCatch } from '../../../helpers.js'
+import { AdminUrlUtil } from '../../../helpers/adminUrlUtil.js'
+import { initPayloadE2ENoConfig } from '../../../helpers/initPayloadE2ENoConfig.js'
+import { reInitializeDB } from '../../../helpers/reInitializeDB.js'
+import { TEST_TIMEOUT_LONG } from '../../../playwright.config.js'
+import { relationshipFieldsSlug } from '../../slugs.js'
+
+const filename = fileURLToPath(import.meta.url)
+const dirname = path.dirname(filename)
+
+const { beforeAll, beforeEach, describe } = test
+
+describe('Relationship cells in the list view', () => {
+  let page: Page
+  let serverURL: string
+  let url: AdminUrlUtil
+
+  beforeAll(async ({ browser }, testInfo) => {
+    testInfo.setTimeout(TEST_TIMEOUT_LONG)
+    ;({ serverURL } = await initPayloadE2ENoConfig({ dirname }))
+    url = new AdminUrlUtil(serverURL, relationshipFieldsSlug)
+
+    const context = await browser.newContext()
+    page = await context.newPage()
+    initPageConsoleErrorCatch(page)
+    await ensureCompilationIsDone({ page, serverURL })
+  })
+
+  beforeEach(async () => {
+    await reInitializeDB({
+      serverURL,
+      snapshotKey: 'fieldsTest',
+      uploadsDir: path.resolve(dirname, './collections/Upload/uploads'),
+    })
+  })
+
+  test('should request each related document once while an earlier batch is still pending', async () => {
+    // RelationshipProvider loads the documents the relationship cells show in one batch per collection
+    // (`GET /api/<slug>?where[id][in]=...`). A requested id stays `null` in its state until the response arrives,
+    // and the loader runs again on every change of that state, so a slow batch used to be requested again each time
+    // another batch came back or more cells mounted. Here the first collection's batch is slowed down; every other
+    // batch answers at once, and no id may be requested twice.
+    const batches: { ids: string[]; slug: string }[] = []
+    let slowSlug: string | undefined
+
+    await page.route(
+      (requestURL) => requestURL.searchParams.has('where[id][in]'),
+      async (route, request) => {
+        const requestURL = new URL(request.url())
+        const slug = requestURL.pathname.split('/').pop()
+        batches.push({ slug, ids: requestURL.searchParams.get('where[id][in]').split(',') })
+        slowSlug ??= slug
+        if (slug === slowSlug) {
+          await new Promise((resolve) => setTimeout(resolve, 1500))
+        }
+        await route.continue()
+      },
+    )
+
+    await page.goto(url.list)
+    await expect(page.locator('.table table tbody tr').first()).toBeVisible()
+    // the slow batch has answered and the debounced loader has run once more
+    await page.waitForTimeout(3000)
+
+    const requested = batches.flatMap(({ ids, slug }) => ids.map((id) => `${slug}:${id}`))
+    const requestedOnce = new Set(requested)
+
+    expect(batches.length).toBeGreaterThan(0)
+    expect(requested).toHaveLength(requestedOnce.size)
+
+    await page.unroute((requestURL) => requestURL.searchParams.has('where[id][in]'))
+  })
+})
