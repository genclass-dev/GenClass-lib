@@ -179,17 +179,29 @@ export function createTaskMutationOptions() {
 	})
 }
 
+// Quick edits overlap their saves, and the responses can land in any order.
+const latestTaskUpdates = new Map<number, Task>()
+
+// Only the newest save of a task may write its response: it carries every edit made before it.
+export function isLatestTaskUpdate(input: Task & Required<Pick<Task, 'id'>>) {
+	return latestTaskUpdates.get(input.id) === input
+}
+
 export function updateTaskMutationOptions(optimistic = false) {
 	return contextMutationOptions({
-		mutationFn: async (task: Task & Required<Pick<Task, 'id'>>) => (await patchTasksRead({
-			path: {task: task.id},
-			body: taskPatchBody(task),
-		})).data,
+		mutationFn: async (task: Task & Required<Pick<Task, 'id'>>) => {
+			latestTaskUpdates.set(task.id, task)
+			return (await patchTasksRead({
+				path: {task: task.id},
+				body: taskPatchBody(task),
+			})).data
+		},
 		optimistic: optimistic ? {
 			queryKeys: ({id}, client) => taskQueryKeys(client, id),
 			update: (task, client) => replaceTaskEverywhere(client, task),
 		} : undefined,
 		onSuccess: (task, input, client) => {
+			if (!isLatestTaskUpdate(input)) return
 			replaceTaskEverywhere(client, task)
 			reconcileDoneBuckets(client, normalizeTask({...task, id: input.id}))
 		},
