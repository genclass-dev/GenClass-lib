@@ -0,0 +1,121 @@
+import { type Page, expect, test } from '@playwright/test';
+
+import { BaseDetailPage } from '../../page-objects/detail-page.base.js';
+import { VendureAdminClient } from '../../utils/vendure-admin-client.js';
+
+// #2117: a double-click on the save button of a detail page must send the create or update
+// mutation only once. The form validates asynchronously before it calls the mutation, and the
+// button is only disabled on the next render, so the second click used to submit the form again
+// and, on a "new" page, create the entity twice.
+
+/** Counts the admin-api requests that carry the given mutation. */
+function countMutations(page: Page, mutationName: string) {
+    const sent: string[] = [];
+    page.on('request', request => {
+        const body = request.postData() ?? '';
+        if (request.method() === 'POST' && body.includes('mutation') && body.includes(`${mutationName}(`)) {
+            sent.push(body);
+        }
+    });
+    return sent;
+}
+
+test.describe('Double-click on the save button submits once (#2117)', () => {
+    const createdName = `E2E Double Click Create ${Date.now()}`;
+    const updatedName = `E2E Double Click Update ${Date.now()}`;
+    let updateTargetId: string;
+
+    const detailConfig = {
+        newPath: '/collections/new',
+        pathPrefix: '/collections/',
+        newTitle: 'New collection',
+    };
+
+    test.beforeAll(async ({ browser }) => {
+        const page = await browser.newPage();
+        const client = new VendureAdminClient(page);
+        await client.login();
+        const { createCollection } = await client.gql(
+            `mutation ($input: CreateCollectionInput!) {
+                createCollection(input: $input) { id }
+            }`,
+            {
+                input: {
+                    filters: [],
+                    translations: [
+                        {
+                            languageCode: 'en',
+                            name: 'E2E Double Click Target',
+                            slug: `e2e-double-click-target-${Date.now()}`,
+                            description: '',
+                        },
+                    ],
+                },
+            },
+        );
+        updateTargetId = createCollection.id as string;
+        await page.close();
+    });
+
+    test.afterAll(async ({ browser }) => {
+        const page = await browser.newPage();
+        const client = new VendureAdminClient(page);
+        await client.login();
+        const { collections } = await client.gql(
+            `query ($names: [String!]!) {
+                collections(options: { filter: { name: { in: $names } } }) { items { id } }
+            }`,
+            { names: [createdName, updatedName, 'E2E Double Click Target'] },
+        );
+        for (const { id } of collections.items) {
+            await client.gql(`mutation ($id: ID!) { deleteCollection(id: $id) { result } }`, { id });
+        }
+        await page.close();
+    });
+
+    test('double-clicking Create creates one collection', async ({ page }) => {
+        const detail = new BaseDetailPage(page, detailConfig);
+        const creates = countMutations(page, 'createCollection');
+
+        await detail.gotoNew();
+        await detail.expectNewPageLoaded();
+        await detail.fillFields([{ label: 'Name', value: createdName }]);
+        await expect(detail.formItem('Slug').getByRole('textbox')).not.toHaveValue('', { timeout: 5_000 });
+        await expect(detail.createButton).toBeEnabled();
+
+        await detail.createButton.dblclick();
+        await detail.expectSuccessToast(/created/i);
+        await detail.expectNavigatedToExisting();
+        // A second submit would have been sent by now
+        await page.waitForTimeout(1000);
+
+        expect(creates).toHaveLength(1);
+        const client = new VendureAdminClient(page);
+        await client.login();
+        const { collections } = await client.gql(
+            `query ($name: String!) {
+                collections(options: { filter: { name: { eq: $name } } }) { totalItems }
+            }`,
+            { name: createdName },
+        );
+        expect(collections.totalItems).toBe(1);
+    });
+
+    test('double-clicking Update sends one update', async ({ page }) => {
+        const detail = new BaseDetailPage(page, detailConfig);
+        const updates = countMutations(page, 'updateCollection');
+
+        await detail.gotoExisting(updateTargetId);
+        await expect(detail.formItem('Name').getByRole('textbox')).toHaveValue('E2E Double Click Target', {
+            timeout: 10_000,
+        });
+        await detail.fillInput('Name', updatedName);
+        await expect(detail.updateButton).toBeEnabled();
+
+        await detail.updateButton.dblclick();
+        await detail.expectSuccessToast(/updated/i);
+        await page.waitForTimeout(1000);
+
+        expect(updates).toHaveLength(1);
+    });
+});
diff --git a/packages/dashboard/src/lib/framework/form-engine/use-generated-form.spec.tsx b/packages/dashboard/src/lib/framework/form-engine/use-generated-form.spec.tsx
