--- a/packages/dashboard/src/lib/framework/form-engine/use-generated-form.spec.tsx
+++ b/packages/dashboard/src/lib/framework/form-engine/use-generated-form.spec.tsx
@@ -131,3 +131,91 @@ describe('useGeneratedForm with a nullable: false custom field', () => {
         unmount();
     });
 });
+
+async function renderSubmittableForm(onSubmit: (values: any) => void | Promise<unknown>) {
+    let result: ReturnType<typeof useGeneratedForm> | undefined;
+    function Probe() {
+        result = useGeneratedForm({
+            document: createDocument,
+            varName: 'input',
+            entity: undefined,
+            customFieldConfig,
+            setValues: e => ({ name: e.name, customFields: e.customFields }),
+            onSubmit,
+        });
+        return null;
+    }
+    const root = createRoot(document.createElement('div'));
+    await act(async () => {
+        root.render(createElement(Probe));
+    });
+    const event = { preventDefault: () => undefined, stopPropagation: () => undefined } as any;
+    return {
+        getForm: () => (result as NonNullable<typeof result>).form,
+        submit: () => (result as NonNullable<typeof result>).submitHandler(event) as Promise<void>,
+        unmount: () => act(() => root.unmount()),
+    };
+}
+
+// #2117: the second click of a double-click must not submit the form a second time
+describe('useGeneratedForm submitHandler', () => {
+    it('ignores a second submit while the first is still being validated', async () => {
+        const onSubmit = vi.fn();
+        const { getForm, submit, unmount } = await renderSubmittableForm(onSubmit);
+        await act(async () => {
+            getForm().setValue('name', 'Warehouse', { shouldValidate: true });
+        });
+        await act(async () => {
+            await Promise.all([submit(), submit()]);
+        });
+        expect(onSubmit).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+
+    it('ignores further submits until the promise returned by onSubmit settles', async () => {
+        let settle: () => void = () => undefined;
+        const onSubmit = vi.fn(() => new Promise<void>(resolve => (settle = resolve)));
+        const { getForm, submit, unmount } = await renderSubmittableForm(onSubmit);
+        await act(async () => {
+            getForm().setValue('name', 'Warehouse', { shouldValidate: true });
+        });
+        let first: Promise<void> | undefined;
+        await act(async () => {
+            first = submit();
+            await vi.waitFor(() => expect(onSubmit).toHaveBeenCalledTimes(1));
+            await submit();
+        });
+        expect(onSubmit).toHaveBeenCalledTimes(1);
+        await act(async () => {
+            settle();
+            await first;
+        });
+        await act(async () => {
+            const next = submit();
+            await vi.waitFor(() => expect(onSubmit).toHaveBeenCalledTimes(2));
+            settle();
+            await next;
+        });
+        unmount();
+    });
+
+    it('accepts a new submit after one that failed validation', async () => {
+        const onSubmit = vi.fn();
+        const { getForm, submit, unmount } = await renderSubmittableForm(onSubmit);
+        await act(async () => {
+            getForm().setValue('name', null as any);
+        });
+        await act(async () => {
+            await submit();
+        });
+        expect(onSubmit).not.toHaveBeenCalled();
+        await act(async () => {
+            getForm().setValue('name', 'Warehouse', { shouldValidate: true });
+        });
+        await act(async () => {
+            await submit();
+        });
+        expect(onSubmit).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+});
