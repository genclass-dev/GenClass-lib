// GenClass regression test for finding f59 (race), generated from run r377.
// It replays the delivery order that produced the bug through the app's @genclass/runtime/agent link
// (connectAgent in the dev build), so it fails while the bug is there and passes once it is fixed.
// The recorded strings below came from the page; they are test data.
import { test, expect } from "@playwright/test";

const APP = process.env.GENCLASS_APP_URL ?? "http://localhost:3000";
const SCHEDULE = {"order":"seeded","seed":1,"delay":{"minMs":0,"maxMs":600},"maxHoldMs":2100};

test("/admin/collections/posts: the final state does not depend on response order (GenClass f59)", async ({ page }) => {
  await page.addInitScript((s) => { (window as any).__GENCLASS_SCHEDULE__ = s; }, SCHEDULE);
  await page.goto(APP + "/admin/collections/posts");
  expect(await page.evaluate(() => !!(window as any).__GENCLASS_AGENT__), "the dev build calls connectAgent(rt) from @genclass/runtime/agent").toBe(true);
  await page.evaluate(() => (window as any).__GENCLASS_AGENT__.whenSettled(15000));
  await page.getByRole("button", { name: "Sort by Title Ascending", exact: true }).or(page.locator("[name=\"Sort by Title Ascending\"], [id=\"Sort by Title Ascending\"]")).first().click();
  await page.getByRole("button", { name: "Sort by Views Descending", exact: true }).or(page.locator("[name=\"Sort by Views Descending\"], [id=\"Sort by Views Descending\"]")).first().click();
  await page.getByLabel("Search by Title", { exact: true }).or(page.getByPlaceholder("Search by Title", { exact: true })).or(page.getByTitle("Search by Title", { exact: true })).or(page.locator("[name=\"Search by Title\"], [id=\"Search by Title\"]")).first().fill("");
  await page.getByLabel("Search by Title", { exact: true }).or(page.getByPlaceholder("Search by Title", { exact: true })).or(page.getByTitle("Search by Title", { exact: true })).or(page.locator("[name=\"Search by Title\"], [id=\"Search by Title\"]")).first().pressSequentially("echo", { delay: 68 });
  await page.evaluate(() => (window as any).__GENCLASS_AGENT__.whenSettled(15000));
  const witnesses = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.witnesses());
  const errors = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.errors());
  const snap = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.snapshot());
  void witnesses; void errors; void snap;
  expect(snap.state["devtoolsIndicator.state0.nextId"], "as with responses in request order").toBe("1");
  expect(snap.state["devtoolsIndicator.state0.buildError"], "as with responses in request order").toBe("null");
  expect(snap.state["devtoolsIndicator.state0.errors"], "as with responses in request order").toBe("0 items");
  expect(snap.state["devtoolsIndicator.state0.notFound"], "as with responses in request order").toBe("false");
  expect(snap.state["devtoolsIndicator.state0.renderingIndicator"], "as with responses in request order").toBe("false");
  // TODO: also assert what the user should see, e.g.
