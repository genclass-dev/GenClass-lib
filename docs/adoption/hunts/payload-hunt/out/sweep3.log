// GenClass regression test for finding f30 (race), generated from run r213.
// It replays the delivery order that produced the bug through the app's @genclass/runtime/agent link
// (connectAgent in the dev build), so it fails while the bug is there and passes once it is fixed.
// The recorded strings below came from the page; they are test data.
import { test, expect } from "@playwright/test";

const APP = process.env.GENCLASS_APP_URL ?? "http://localhost:3000";
const SCHEDULE = {"order":"seeded","seed":5,"delay":{"minMs":0,"maxMs":300},"maxHoldMs":1800};

test("/admin/collections/posts/1: the final state does not depend on response order (GenClass f30)", async ({ page }) => {
  await page.addInitScript((s) => { (window as any).__GENCLASS_SCHEDULE__ = s; }, SCHEDULE);
  await page.goto(APP + "/admin/collections/posts/1");
  expect(await page.evaluate(() => !!(window as any).__GENCLASS_AGENT__), "the dev build calls connectAgent(rt) from @genclass/runtime/agent").toBe(true);
  await page.evaluate(() => (window as any).__GENCLASS_AGENT__.whenSettled(15000));
  await page.getByRole("combobox", { name: new RegExp("^react-select-_R_1d9mljlqkuatpesneb6jd9e") }).first().click();
  await page.getByRole("combobox", { name: new RegExp("^react-select-_R_1d9mljlqkuatpesneb6jd9e") }).first().fill("");
  await page.getByRole("combobox", { name: new RegExp("^react-select-_R_1d9mljlqkuatpesneb6jd9e") }).first().pressSequentially("Category r", { delay: 118 });
  await page.evaluate(() => (window as any).__GENCLASS_AGENT__.whenSettled(15000));
  const witnesses = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.witnesses());
  const errors = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.errors());
  const snap = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.snapshot());
  void witnesses; void errors; void snap;
  expect(snap.state["fieldAuthor.state3"], "as with responses in request order").toBe("\"\"");
  expect(snap.state["fieldAuthor.state4"], "as with responses in request order").toBe("\"\"");
  expect(snap.state["fieldAuthor.state5"], "as with responses in request order").toBe("false");
  expect(snap.state["fieldAuthor.state6"], "as with responses in request order").toBe("true");
  expect(snap.state["fieldAuthor.state7"], "as with responses in request order").toBe("false");
  // TODO: also assert what the user should see, e.g.
  // await expect(page.getByRole("listitem").first()).toContainText("...");
});
