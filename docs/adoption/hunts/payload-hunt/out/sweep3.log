// GenClass regression test for finding f20 (race), generated from run r156.
// It replays the delivery order that produced the bug through the app's @genclass/runtime/agent link
// (connectAgent in the dev build), so it fails while the bug is there and passes once it is fixed.
// The recorded strings below came from the page; they are test data.
import { test, expect } from "@playwright/test";

const APP = process.env.GENCLASS_APP_URL ?? "http://localhost:3000";
const SCHEDULE = {"order":"seeded","seed":2,"delay":{"minMs":0,"maxMs":300},"maxHoldMs":1800};

test("/admin/collections/posts/4: the final state does not depend on response order (GenClass f20)", async ({ page }) => {
  await page.addInitScript((s) => { (window as any).__GENCLASS_SCHEDULE__ = s; }, SCHEDULE);
  await page.goto(APP + "/admin/collections/posts/4");
  expect(await page.evaluate(() => !!(window as any).__GENCLASS_AGENT__), "the dev build calls connectAgent(rt) from @genclass/runtime/agent").toBe(true);
  await page.evaluate(() => (window as any).__GENCLASS_AGENT__.whenSettled(15000));
  await page.getByLabel("Title", { exact: true }).or(page.getByPlaceholder("Title", { exact: true })).or(page.getByTitle("Title", { exact: true })).or(page.locator("[name=\"Title\"], [id=\"Title\"]")).first().click();
  await page.getByLabel("Title", { exact: true }).or(page.getByPlaceholder("Title", { exact: true })).or(page.getByTitle("Title", { exact: true })).or(page.locator("[name=\"Title\"], [id=\"Title\"]")).first().fill("");
  await page.getByLabel("Title", { exact: true }).or(page.getByPlaceholder("Title", { exact: true })).or(page.getByTitle("Title", { exact: true })).or(page.locator("[name=\"Title\"], [id=\"Title\"]")).first().pressSequentially("autosave two base one", { delay: 93 });
  await page.getByLabel("Title", { exact: true }).or(page.getByPlaceholder("Title", { exact: true })).or(page.getByTitle("Title", { exact: true })).or(page.locator("[name=\"Title\"], [id=\"Title\"]")).first().pressSequentially("two", { delay: 93 });
  await page.getByLabel("Title", { exact: true }).or(page.getByPlaceholder("Title", { exact: true })).or(page.getByTitle("Title", { exact: true })).or(page.locator("[name=\"Title\"], [id=\"Title\"]")).first().pressSequentially("three", { delay: 93 });
  await page.getByLabel("Title", { exact: true }).or(page.getByPlaceholder("Title", { exact: true })).or(page.getByTitle("Title", { exact: true })).or(page.locator("[name=\"Title\"], [id=\"Title\"]")).first().pressSequentially("four", { delay: 90 });
  await page.getByLabel("Title", { exact: true }).or(page.getByPlaceholder("Title", { exact: true })).or(page.getByTitle("Title", { exact: true })).or(page.locator("[name=\"Title\"], [id=\"Title\"]")).first().pressSequentially("five", { delay: 96 });
  await page.evaluate(() => (window as any).__GENCLASS_AGENT__.whenSettled(15000));
  const witnesses = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.witnesses());
  const errors = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.errors());
  const snap = await page.evaluate(() => (window as any).__GENCLASS_AGENT__.snapshot());
  void witnesses; void errors; void snap;
  expect(snap.state["ax.state1"], "as with responses in request order").toBe("\"October 24th 2026, 6:49 PM\"");
  expect(snap.state["it.state0"], "as with responses in request order").toBe("true");
  expect(snap.state["it.state1"], "as with responses in request order").toBe("false");
  expect(snap.state["it.state2"], "as with responses in request order").toBe("false");
  expect(snap.state["Mte.state0"], "as with responses in request order").toBe("null");
