+import { describe, expect, test, vi } from "vitest";
+import { useRecipeSearch } from "../use-recipe-search";
+import type { UserApi } from "~/lib/api";
+import type { Recipe } from "~/lib/api/types/recipe";
+
+describe("useRecipeSearch", () => {
+  const recipesFor = (term: string): Recipe[] => [{ name: `${term} recipe` }];
+
+  // each search resolves only when the test says so, so responses can arrive out of order
+  function createApi() {
+    const pending: Record<string, () => void> = {};
+    const search = vi.fn(({ search }: { search: string }) => new Promise((resolve) => {
+      pending[search] = () => resolve({ data: { items: recipesFor(search) }, error: null });
+    }));
+    const api = { recipes: { search } } as unknown as UserApi;
+    return { api, search, pending };
+  }
+
+  test("an older response that arrives last does not overwrite newer results", async () => {
+    const { api, pending } = createApi();
+    const search = useRecipeSearch(api);
+
+    search.query.value = "chi";
+    const first = search.trigger();
+    search.query.value = "chicken";
+    const second = search.trigger();
+
+    pending.chicken();
+    await second;
+    expect(search.data.value).toEqual(recipesFor("chicken"));
+    expect(search.loading.value).toBe(false);
+
+    pending.chi();
+    await first;
+    expect(search.data.value).toEqual(recipesFor("chicken"));
+  });
+
+  test("loading stays on until the latest search returns", async () => {
+    const { api, pending } = createApi();
+    const search = useRecipeSearch(api);
+
+    search.query.value = "chi";
+    const first = search.trigger();
+    search.query.value = "chicken";
+    const second = search.trigger();
+
+    pending.chi();
+    await first;
+    expect(search.loading.value).toBe(true);
+    expect(search.data.value).toEqual([]);
+
+    pending.chicken();
+    await second;
+    expect(search.loading.value).toBe(false);
+    expect(search.data.value).toEqual(recipesFor("chicken"));
+  });
+});
