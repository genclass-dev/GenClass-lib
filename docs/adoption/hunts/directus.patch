+import { flushPromises, mount } from '@vue/test-utils';
+import { afterEach, describe, expect, test, vi } from 'vitest';
+import InputAutocompleteApi from './input-autocomplete-api.vue';
+import api from '@/api';
+
+vi.mock('@/api', () => ({
+	default: { get: vi.fn() },
+}));
+
+const mountOptions = {
+	props: {
+		value: null,
+		url: '/items/tags?search={{value}}',
+		resultsPath: 'data',
+		textPath: 'name',
+		valuePath: 'name',
+		trigger: 'debounce' as const,
+		rate: 0,
+	},
+	global: {
+		mocks: {
+			$t: (key: string) => key,
+		},
+		stubs: {
+			'v-menu': {
+				template: '<div><slot name="activator" :activate="() => {}" :deactivate="() => {}" /><slot /></div>',
+			},
+			'v-input': {
+				name: 'v-input',
+				props: ['modelValue'],
+				emits: ['update:model-value'],
+				template: '<input />',
+			},
+			'v-list': { template: '<ul><slot /></ul>' },
+			'v-list-item': { template: '<li><slot /></li>' },
+			'v-list-item-content': { template: '<span><slot /></span>' },
+			'v-icon': true,
+			'v-notice': true,
+		},
+	},
+};
+
+afterEach(() => {
+	vi.clearAllMocks();
+});
+
+describe('input-autocomplete-api', () => {
+	test('ignores the results of an earlier input when they resolve last', async () => {
+		const respond: ((value: unknown) => void)[] = [];
+
+		for (let i = 0; i < 2; i++) {
+			vi.mocked(api.get).mockImplementationOnce(() => new Promise((resolve) => respond.push(resolve)) as any);
+		}
+
+		const wrapper = mount(InputAutocompleteApi, mountOptions);
+		const input = wrapper.findComponent({ name: 'v-input' });
+
+		input.vm.$emit('update:model-value', 're');
+		await vi.waitFor(() => expect(api.get).toHaveBeenCalledTimes(1));
+
+		input.vm.$emit('update:model-value', 'rea');
+		await vi.waitFor(() => expect(api.get).toHaveBeenCalledTimes(2));
+
+		respond[1]!({ data: { data: [{ name: 'react' }] } });
+		await flushPromises();
+
+		respond[0]!({ data: { data: [{ name: 'react' }, { name: 'redis' }] } });
+		await flushPromises();
+
+		expect(wrapper.findAll('li').map((item) => item.text())).toEqual(['react']);
+	});
+});
