===== 8. The agent fixes the code; the same order no longer reproduces it, and explore finds no race

$ diff -u ../steps/02-main.js src/main.js | tail -n +3
@@ -8,11 +8,15 @@
 
 const $ = (s) => document.querySelector(s);
 
-// Search: every keystroke fetches; whichever response arrives last wins, even if it answers an older query.
+// Search: every keystroke fetches; only the response to the latest query may write the results (the fix: a sequence
+// number per request; an older response that arrives later is ignored).
+let searchSeq = 0;
 $("#q").addEventListener("input", async (e) => {
   const q = e.target.value;
+  const mine = ++searchSeq;
