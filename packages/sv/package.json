{
  "name": "@genclass/sv",
  "version": "0.1.0",
  "description": "A community add-on for the Svelte CLI: npx sv add @genclass sets up GenClass in a SvelteKit app (the @genclass/runtime dependency, its import first in src/hooks.client, the devtools overlay in development). GenClass reports race conditions in the browser: stale responses, duplicate requests, failure storms.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genclass-dev/GenClass-lib.git",
    "directory": "packages/sv"
  },
  "homepage": "https://genclass.dev",
  "bugs": { "url": "https://github.com/genclass-dev/GenClass-lib/issues" },
  "keywords": [
    "sv-add",
    "svelte",
    "sveltekit",
    "genclass",
    "race-condition",
    "stale-response",
    "duplicate-request"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "sv": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/sv-utils": "1.0.2",
    "@types/node": "^22.0.0",
    "sv": "1.1.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
