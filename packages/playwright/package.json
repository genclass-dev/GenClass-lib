{
  "name": "@genclass/playwright",
  "version": "0.1.0",
  "description": "GenClass for Playwright: a fixture that puts @genclass/runtime on every page under test (observe mode, seeded network chaos with page.route) and writes one race file per test, and a reporter that turns those files into one markdown report your CI posts on the pull request. Peer dependencies only.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genclass-dev/GenClass-lib.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/genclass-dev/GenClass-lib/tree/main/packages/playwright#readme",
  "bugs": { "url": "https://github.com/genclass-dev/GenClass-lib/issues" },
  "keywords": [
    "playwright",
    "playwright-reporter",
    "flaky-tests",
    "race-condition",
    "stale-response",
    "duplicate-request",
    "genclass",
    "e2e",
    "reporter",
    "test-reporter",
    "github-actions",
    "pull-request",
    "ci"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./summarize": {
      "types": "./dist/summarize.d.ts",
      "import": "./dist/summarize.js",
      "default": "./dist/summarize.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    },
    "./fixture": {
      "types": "./dist/fixture.d.ts",
      "import": "./dist/fixture.js",
      "default": "./dist/fixture.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "genclass-playwright-report": "bin/genclass-playwright-report.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@genclass/runtime": ">=0.3.0-beta.1",
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@genclass/runtime": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@genclass/runtime": "0.3.0-beta.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
