{
  "name": "@genclass/playwright",
  "version": "0.1.0",
  "description": "A Playwright reporter for GenClass race files: reads what the GenClass fixture flagged in each test (duplicate submits, stale responses, failing endpoints, with the evidence line and the model's confidence) and writes one markdown report your CI can post on the pull request. No runtime dependencies.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genclass-dev/GenClass-lib.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://genclass.dev",
  "bugs": { "url": "https://github.com/genclass-dev/GenClass-lib/issues" },
  "keywords": [
    "playwright",
    "playwright-reporter",
    "flaky-tests",
    "race-condition",
    "stale-response",
    "duplicate-request",
    "genclass",
    "e2e"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./summarize": {
      "types": "./dist/summarize.d.ts",
      "import": "./dist/summarize.js",
      "default": "./dist/summarize.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "genclass-playwright-report": "bin/genclass-playwright-report.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
